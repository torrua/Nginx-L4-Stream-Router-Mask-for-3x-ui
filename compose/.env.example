# ==============================================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ДЛЯ ПРОТОКОЛОВ СЛЕДУЮЩЕГО ПОКОЛЕНИЯ И DOKPLOY
# ==============================================================================

# Общий домен сервера
PRIMARY_DOMAIN=yourdomain.online
LE_EMAIL=admin@yourdomain.online

# 1. MASQUE (RFC 9484 / RFC 9298 Sing-box 1.14+)
ENABLE_MASQUE=y
MASQUE_PORT=8445
MASQUE_USER=client
MASQUE_PASS=ChangeMeSecretMasquePass2026!
MASQUE_CERT_PATH=/etc/letsencrypt/live/yourdomain.online/fullchain.pem
MASQUE_KEY_PATH=/etc/letsencrypt/live/yourdomain.online/privkey.pem

# 2. ShadowTLS v4 + Shadowsocks-2022
ENABLE_SHADOWTLS=y
SHADOWTLS_PORT=8543
SHADOWTLS_SNI=gateway.icloud.com
SHADOWTLS_PASSWORD=ChangeMeShadowTlsPassword2026!
SS2022_BACKEND_HOST=127.0.0.1
SS2022_BACKEND_PORT=8388

# 3. NaïveProxy + Caddy (Cloudflare DNS-01 ACME)
ENABLE_NAIVE=y
NAIVE_PORT=8446
NAIVE_DOMAIN=naive.yourdomain.online
NAIVE_USER=naiveuser
NAIVE_PASS=ChangeMeNaivePassword2026!
CLOUDFLARE_API_TOKEN=

# 4. Server-Side Zapret (nfqws with connbytes 1:6)
ENABLE_ZAPRET=y
ZAPRET_QNUM=200
ZAPRET_DESYNC=split2
ZAPRET_FOOLING=md5sig,badseq

# 5. Wstunnel over Dokploy Traefik
ENABLE_WSTUNNEL=y
WSTUNNEL_DOMAIN=wstunnel.yourdomain.online
WSTUNNEL_PREFIX=/wstunnel
WSTUNNEL_PORT=8080
WSTUNNEL_SECRET=ChangeMeWstunnelSecret2026!
DOKPLOY_TRAEFIK_NETWORK=dokploy-network
