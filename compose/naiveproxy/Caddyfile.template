{
  order forward_proxy before reverse_proxy
}

:8446, {$NAIVE_DOMAIN}:8446 {
  tls {$LE_EMAIL} {
    dns cloudflare {$CLOUDFLARE_API_TOKEN}
  }

  forward_proxy {
    basic_auth {$NAIVE_USER} {$NAIVE_PASS}
    hide_ip
    hide_via
    probe_resistance secret-probe.localhost
  }

  file_server {
    root /var/www/html
  }
}
