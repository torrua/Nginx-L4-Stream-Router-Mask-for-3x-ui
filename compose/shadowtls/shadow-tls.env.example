# Режим работы: server
MODE=server

# Протокол ShadowTLS v3/v4
V3=1

# Внешний порт прослушивания ShadowTLS
LISTEN=0.0.0.0:8543

# Адрес локального Shadowsocks-2022 бэкенда (с включенным udp_over_tcp)
SERVER=127.0.0.1:8388

# Домен маскировки для сканеров и ботов (при неверном HMAC-пароле трафик пересылается сюда)
TLS=gateway.icloud.com:443
TLS_NAMES=gateway.icloud.com

# Секретный пароль для валидации HMAC клиента ShadowTLS
PASSWORD=CHANGE_ME_SHADOWTLS_PASSWORD
